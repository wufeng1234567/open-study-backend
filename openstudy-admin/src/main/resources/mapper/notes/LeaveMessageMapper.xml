<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openstudy.notes.mapper.LeaveMessageMapper">

    <resultMap type="LeaveMessage" id="LeaveMessageResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="content" column="content"/>
        <result property="ip" column="ip"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectLeaveMessageVo">
        select id, user_id, user_name, content, ip, status, create_time
        from leave_message
    </sql>

    <select id="selectLeaveMessageList" parameterType="LeaveMessage" resultMap="LeaveMessageResult">
        <include refid="selectLeaveMessageVo"/>
        <where>
            status = 1
            <if test="userName != null and userName != ''">
                and user_name like concat('%', #{userName}, '%')
            </if>
            <if test="content != null and content != ''">
                and content like concat('%', #{content}, '%')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectLeaveMessageById" resultMap="LeaveMessageResult">
        <include refid="selectLeaveMessageVo"/>
        where id = #{id} and status = 1
    </select>

    <insert id="insertLeaveMessage" parameterType="LeaveMessage" useGeneratedKeys="true" keyProperty="id">
        insert into leave_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="ip != null and ip != ''">ip,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="ip != null and ip != ''">#{ip},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="deleteLeaveMessageById">
        update leave_message set status = 0 where id = #{id}
    </update>

    <update id="deleteLeaveMessageByIds">
        update leave_message set status = 0 where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <update id="updateLeaveMessage" parameterType="LeaveMessage">
        update leave_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null and content != ''">content = #{content},</if>
        </trim>
        where id = #{id}
    </update>

</mapper>
