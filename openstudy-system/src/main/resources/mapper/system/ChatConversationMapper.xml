<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openstudy.system.mapper.ChatConversationMapper">

    <resultMap type="com.openstudy.system.domain.ChatConversation" id="ChatConversationResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="otherUserId" column="other_user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="ChatConversationResult">
        SELECT * FROM chat_conversation
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserIdAndOtherId" resultMap="ChatConversationResult">
        SELECT * FROM chat_conversation
        WHERE user_id = #{userId} AND other_user_id = #{otherUserId}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.openstudy.system.domain.ChatConversation">
        <selectKey keyProperty="id" resultType="Long" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
        INSERT INTO chat_conversation (user_id, other_user_id, create_time)
        VALUES (#{userId}, #{otherUserId}, NOW())
    </insert>

    <delete id="deleteByUserIdAndOtherId">
        DELETE FROM chat_conversation
        WHERE user_id = #{userId} AND other_user_id = #{otherUserId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM chat_conversation
        WHERE user_id = #{userId}
    </delete>

</mapper>
