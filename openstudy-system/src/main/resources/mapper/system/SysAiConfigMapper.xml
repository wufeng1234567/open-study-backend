<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.openstudy.system.mapper.SysAiConfigMapper">

    <resultMap type="com.openstudy.system.domain.SysAiConfig" id="SysAiConfigResult">
        <result property="configId" column="config_id"/>
        <result property="userId" column="user_id"/>
        <result property="provider" column="provider"/>
        <result property="providerName" column="provider_name"/>
        <result property="model" column="model"/>
        <result property="apiKey" column="api_key"/>
        <result property="baseUrl" column="base_url"/>
        <result property="isDefault" column="is_default"/>
        <result property="isEnabled" column="is_enabled"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="thinkingMode" column="thinking_mode"/>
        <result property="reasoningEffort" column="reasoning_effort"/>
        <result property="contextLength" column="context_length"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <sql id="selectSysAiConfigVo">
        select config_id, user_id, provider, provider_name, model, api_key, base_url, is_default, is_enabled, status, remark, thinking_mode, reasoning_effort, context_length, create_time, update_time, create_by, update_by
        from sys_ai_config
    </sql>

    <select id="selectSysAiConfigList" parameterType="com.openstudy.system.domain.SysAiConfig" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        <where>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="provider != null and provider != ''">
                and provider = #{provider}
            </if>
            <if test="model != null and model != ''">
                and model = #{model}
            </if>
            <if test="isDefault != null">
                and is_default = #{isDefault}
            </if>
            <if test="isEnabled != null">
                and is_enabled = #{isEnabled}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectSysAiConfigById" parameterType="Long" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        where config_id = #{configId}
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        where user_id = #{userId}
        order by is_default desc, create_time desc
    </select>

    <select id="selectByUserAndProvider" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        where user_id = #{userId} and provider = #{provider}
        order by is_default desc
        limit 1
    </select>

    <select id="selectDefaultByUserId" parameterType="Long" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        where user_id = #{userId} and is_default = 1 and is_enabled = 1
        limit 1
    </select>

    <select id="selectSystemDefault" resultMap="SysAiConfigResult">
        <include refid="selectSysAiConfigVo"/>
        where user_id is null and is_default = 1 and is_enabled = 1
        limit 1
    </select>

    <insert id="insertSysAiConfig" parameterType="com.openstudy.system.domain.SysAiConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into sys_ai_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="provider != null and provider != ''">provider,</if>
            <if test="providerName != null">provider_name,</if>
            <if test="model != null and model != ''">model,</if>
            <if test="apiKey != null">api_key,</if>
            <if test="baseUrl != null">base_url,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="isEnabled != null">is_enabled,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="thinkingMode != null">thinking_mode,</if>
            <if test="reasoningEffort != null">reasoning_effort,</if>
            <if test="contextLength != null">context_length,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="provider != null and provider != ''">#{provider},</if>
            <if test="providerName != null">#{providerName},</if>
            <if test="model != null and model != ''">#{model},</if>
            <if test="apiKey != null">#{apiKey},</if>
            <if test="baseUrl != null">#{baseUrl},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="isEnabled != null">#{isEnabled},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="thinkingMode != null">#{thinkingMode},</if>
            <if test="reasoningEffort != null">#{reasoningEffort},</if>
            <if test="contextLength != null">#{contextLength},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            now(),
        </trim>
    </insert>

    <update id="updateSysAiConfig" parameterType="com.openstudy.system.domain.SysAiConfig">
        update sys_ai_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="providerName != null">provider_name = #{providerName},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="baseUrl != null">base_url = #{baseUrl},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="thinkingMode != null">thinking_mode = #{thinkingMode},</if>
            <if test="reasoningEffort != null">reasoning_effort = #{reasoningEffort},</if>
            <if test="contextLength != null">context_length = #{contextLength},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now(),
        </trim>
        where config_id = #{configId}
    </update>

    <delete id="deleteSysAiConfigById" parameterType="Long">
        delete from sys_ai_config where config_id = #{configId}
    </delete>

    <delete id="deleteSysAiConfigByIds" parameterType="Long">
        delete from sys_ai_config where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>

    <update id="clearUserDefault">
        update sys_ai_config set is_default = 0 where user_id = #{userId}
    </update>

</mapper>
